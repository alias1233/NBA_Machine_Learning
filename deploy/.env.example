DOMAIN=example.com

ACME_EMAIL=you@example.com

# BALLDONTLIE API key with the ALL-STAR tier.
BALL_DONT_LIE_KEY=...

# Host directories the containers write to.
DATA_DIRECTORY=./data
BACKUP_DIRECTORY=./backups

# Prediction limits per process: max running, max queued, and seconds to wait in the queue.
NBA_ML_MAX_RUNNING_PREDICTIONS=4
# Max running when no feature build has been published.
NBA_ML_MAX_RUNNING_UNBUILT_PREDICTIONS=1
NBA_ML_MAX_WAITING_PREDICTIONS=8
NBA_ML_PREDICTION_WAIT_SECONDS=10
