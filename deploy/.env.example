# Copy to .env beside this file and fill in. .env is not in the repository.

# The name the certificate is issued for. It has to point at this server already, and so does
# www.<domain>: the Caddyfile redirects the www name, so it asks for a certificate for that too and
# retries a name that does not resolve for as long as it runs.
#
# The site bakes its own origin in at build time, so this has to match SITE_ORIGIN in
# web/src/lib/site.ts and the sitemap line in web/static/robots.txt. Changing only this one serves a
# healthy site that advertises the wrong name to search engines.
DOMAIN=example.com
# Where the certificate authority writes if a renewal fails.
ACME_EMAIL=you@example.com

# BALLDONTLIE NBA API key. The collection job uses only ALL-STAR endpoints.
BALL_DONT_LIE_KEY=...

# Where the collected data, the feature builds and the model files live on the host. Anything the
# containers write goes here, so this is the directory to move a deployment by.
DATA_DIRECTORY=./data
BACKUP_DIRECTORY=./backups

# How many predictions run at once, how many may queue, and how long one waits for a slot. Per
# process. Four together were measured at 0.45 GB. See nba_ml/api/limits.py.
NBA_ML_MAX_RUNNING_PREDICTIONS=4
NBA_ML_MAX_WAITING_PREDICTIONS=8
NBA_ML_PREDICTION_WAIT_SECONDS=10
