# The scheduled half of the deployment. Install with:
#   crontab deploy/crontab
# after changing the path below to where the repository was cloned.
#
# Each line starts a container that exits when it is finished, so nothing holds memory between runs.
# Times are the server's clock, which is UTC on a rented box.

NBA_ML=/srv/nba-ml/deploy

# Refresh the locally stored schedule once a day. The hourly job reads it, so it does no provider
# work or feature build on days without games.
15 12 * * * flock -n $NBA_ML/.jobs.lock sh -c 'cd $NBA_ML && docker compose run --rm jobs nba-collect --source balldontlie schedule' >> $NBA_ML/logs/nba-ml.log 2>&1

# Collect and rebuild only while the schedule covers today or yesterday. A nonblocking lock keeps a
# slow provider response from overlapping the next hour's write.
0 * * * * flock -n $NBA_ML/.jobs.lock sh -c 'cd $NBA_ML && docker compose run --rm jobs' >> $NBA_ML/logs/nba-ml.log 2>&1

# The databases and the model files, which are the only things here that cannot be rebuilt. Nightly,
# after the hour's collection has finished. Keeps a week.
20 4 * * * flock -w 3600 $NBA_ML/.jobs.lock sh -c 'cd $NBA_ML && docker compose run --rm jobs nba-backup' >> $NBA_ML/logs/nba-ml.log 2>&1
