# Install with: sudo install -m 0644 deploy/crontab /etc/cron.d/bazaarball

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NBA_ML=/srv/bazaarball/deploy

# Refresh the stored schedule.
15 12 * * * root sh -c 'cd $NBA_ML && flock -E 99 -w 1800 .jobs.lock docker compose run --rm jobs nba-collect --source balldontlie schedule; [ $? -ne 99 ] || echo "Skipped the schedule refresh: another job held the lock for half an hour."' >> $NBA_ML/logs/nba-ml.log 2>&1

# Collect new games and rebuild the features.
0 * * * * root sh -c 'cd $NBA_ML && flock -E 99 -n .jobs.lock docker compose run --rm jobs; [ $? -ne 99 ] || echo "Skipped this hour: the previous run is still going."' >> $NBA_ML/logs/nba-ml.log 2>&1

# Draw the home page samples.
30 13 * * * root sh -c 'cd $NBA_ML && flock -E 99 -w 1800 .jobs.lock docker compose run --rm jobs nba-showcase; [ $? -ne 99 ] || echo "Skipped the showcase draw: another job held the lock for half an hour."' >> $NBA_ML/logs/nba-ml.log 2>&1

# Back up the databases and the model files.
20 4 * * * root sh -c 'cd $NBA_ML && flock -E 99 -w 3600 .jobs.lock docker compose run --rm jobs nba-backup; [ $? -ne 99 ] || echo "Skipped the backup: another job held the lock for an hour."' >> $NBA_ML/logs/nba-ml.log 2>&1
