# The scheduled half of the deployment. Install as an isolated system cron file with:
#   sudo install -m 0644 deploy/crontab /etc/cron.d/bazaarball
#
# Install this last, after the data directory has been loaded. The hourly job opens the databases,
# and opening one creates it, which is enough to make `nba-serving-data load` refuse the directory.
#
# Each line starts a container that exits when it is finished, so nothing holds memory between runs.
# Times are the server's clock, which is UTC on a rented box.
#
# One lock serialises the four jobs, because they write the same databases. A job that cannot take
# it says so in the log rather than disappearing: `flock -E 99` gives losing the race an exit code
# of its own, which is what separates it from the job itself failing. The daily jobs wait for the
# lock, since missing one costs a day. The hourly job does not, since the next hour is an hour away.

SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
NBA_ML=/srv/bazaarball/deploy

# Refresh the locally stored schedule once a day. The hourly job reads it, so it does no provider
# work or feature build on days without games. Waits half an hour, which still lands before the
# showcase draw at 13:30.
15 12 * * * root sh -c 'cd $NBA_ML && flock -E 99 -w 1800 .jobs.lock docker compose run --rm jobs nba-collect --source balldontlie schedule; [ $? -ne 99 ] || echo "Skipped the schedule refresh: another job held the lock for half an hour."' >> $NBA_ML/logs/nba-ml.log 2>&1

# Collect and rebuild only while the schedule covers today or yesterday. A nonblocking lock keeps a
# slow provider response from overlapping the next hour's write.
0 * * * * root sh -c 'cd $NBA_ML && flock -E 99 -n .jobs.lock docker compose run --rm jobs; [ $? -ne 99 ] || echo "Skipped this hour: the previous run is still going."' >> $NBA_ML/logs/nba-ml.log 2>&1

# Draw the home page samples after the day's first collection and feature build.
30 13 * * * root sh -c 'cd $NBA_ML && flock -E 99 -w 1800 .jobs.lock docker compose run --rm jobs nba-showcase; [ $? -ne 99 ] || echo "Skipped the showcase draw: another job held the lock for half an hour."' >> $NBA_ML/logs/nba-ml.log 2>&1

# The databases and the model files, which are the only things here that cannot be rebuilt. Nightly,
# after the hour's collection has finished. Keeps a week.
20 4 * * * root sh -c 'cd $NBA_ML && flock -E 99 -w 3600 .jobs.lock docker compose run --rm jobs nba-backup; [ $? -ne 99 ] || echo "Skipped the backup: another job held the lock for an hour."' >> $NBA_ML/logs/nba-ml.log 2>&1
