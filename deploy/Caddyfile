# TLS and the only door open to the internet. Certificates are obtained and renewed on their own.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	handle /health {
		reverse_proxy api:8000
	}

	# The site renders on the server and serves its own static files, so everything else goes to it.
	handle {
		reverse_proxy web:3000
	}

	# The site's own long cache reaches only its hashed bundles, so everything else is revalidated on
	# every visit. Weight is a product constraint, and these are the files a returning reader would
	# otherwise ask about again each time.
	@faces path /fonts/*
	header @faces Cache-Control "public, max-age=31536000, immutable"

	# The favicon and the two policy files change without changing name, so they are cached for long
	# enough to save the round trip and short enough that an edit is picked up the same day.
	@named_files path /favicon.png /robots.txt /sitemap.xml
	header @named_files Cache-Control "public, max-age=3600"

	header {
		Content-Security-Policy "frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Beside the cron log rather than in /data, which holds the certificates: a log is worth reading
	# from the host and the certificates are worth never deleting by reaching for a log.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
